# Files excluded from VS Code extension packaging
# Only the compiled JS and necessary resources are included in the .vsix

src/**
.vscode/**
tsconfig.json
# 编译产物仅依赖 Node 内置模块与 vscode 运行时，node_modules 不需要进入包体
node_modules/**

# Include the compiled output
!out/**

# Include resources (Activity Bar icon)
!resources/**

# Include package.json and README (automatically included by vsce)